version: "3.9"

services:
  redis:
    image: redis:7-alpine
    restart: unless-stopped
    ports:
      - "6379:6379"
    volumes:
      - redis_data:/data
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 5s
      timeout: 3s
      retries: 5

  celery_worker:
    build:
      context: .
      dockerfile: Dockerfile
    command: celery -A celery_app worker --loglevel=info --concurrency=4 -Q literature,data_audit,default
    restart: unless-stopped
    environment:
      REDIS_URL: redis://redis:6379/0
      CELERY_RESULT_BACKEND: redis://redis:6379/1
    depends_on:
      redis:
        condition: service_healthy
    volumes:
      - .:/app

  streamlit_app:
    build:
      context: .
      dockerfile: Dockerfile
    command: streamlit run portal.py --server.port=8501 --server.address=0.0.0.0
    restart: unless-stopped
    ports:
      - "8501:8501"
    environment:
      REDIS_URL: redis://redis:6379/0
      CELERY_RESULT_BACKEND: redis://redis:6379/1
      # Set these two for the sole real admin bootstrap — see portal.py header.
      SOVEREIGN_ADMIN_EMAIL: ${SOVEREIGN_ADMIN_EMAIL:-}
      SOVEREIGN_ADMIN_PASSWORD: ${SOVEREIGN_ADMIN_PASSWORD:-}
    depends_on:
      redis:
        condition: service_healthy
    volumes:
      - .:/app

volumes:
  redis_data: