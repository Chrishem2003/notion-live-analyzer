# Copy to .env (local) or paste into your host's secrets manager.
# Streamlit Community Cloud: Settings → Secrets, in TOML form (KEY = "value").
# Everything except NOTION_TOKEN is optional — the app degrades gracefully and
# tells you in the UI which feature a missing variable disables.

# ─── Notion ───────────────────────────────────────────────────────────
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DATABASE_ID=
# Premium one-time workspace duplication link (keep private).
NOTION_TEMPLATE_URL=

# ─── Deployment ───────────────────────────────────────────────────────
# Public URL of this deployment. Without it the server-side keep-alive stays
# off (pinging the container's own localhost keeps nothing awake).
APP_URL=https://your-app.streamlit.app
AUTO_FIX_DEPS=true

# ─── Accounts & persistence ───────────────────────────────────────────
# Without Supabase, accounts live in a local SQLite file that hosted
# containers wipe on redeploy. Create the tables with docs/supabase_schema.sql.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Local override for the SQLite fallback path.
ACCOUNTS_DB_PATH=

# ─── Admin ────────────────────────────────────────────────────────────
# Comma-separated emails that may open the developer console.
ADMIN_EMAILS=chrishem242@gmail.com
# Second factor for the console — unset means the console stays locked.
ADMIN_PANEL_PASSWORD=
# Unlocks the professor-facing forensic audit view. Unset means locked.
FORENSIC_MASTER_PASSWORD=

# ─── Billing (Stripe) ─────────────────────────────────────────────────
# Unset means the pricing page shows plans without a checkout button.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STANDARD=price_xxx
STRIPE_PRICE_PREMIUM=price_xxx

# ─── Email reports ────────────────────────────────────────────────────
# Needs a sender address plus ONE transport. With neither, the "Email this
# report" panel explains that delivery is off and downloads keep working.
# The sender must be a verified sender/domain or mail will bounce.
REPORT_SENDER_EMAIL=
REPORT_SENDER_NAME=CHRISHEM Research Suite
# Option A — SendGrid REST API (best deliverability).
SENDGRID_API_KEY=
# Option B — SMTP. For Gmail use an app password, not the account password:
# SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USERNAME=<address>.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
