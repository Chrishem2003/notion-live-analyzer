# ───────────────────────────────────────────────────────────────────────
# Multi-Problem Solver — Environment Configuration
# Copy this file to `.env` and fill in your values. NEVER commit `.env`.
# ───────────────────────────────────────────────────────────────────────

# ── LLM Routing ────────────────────────────────────────────────────────
# Google Gemini API key (heavy cross-sector synthesis)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Local Ollama (light text processing / embeddings) — http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ── Async Task Queue (Celery + Redis) ──────────────────────────────────
# Set CELERY_MODE=1 to force the Celery/Redis path; otherwise the app uses
# an in-process ThreadPoolExecutor so it runs anywhere without Redis.
CELERY_MODE=0
REDIS_URL=redis://localhost:6379/0

# ── PostgreSQL (pgvector RAG) ─────────────────────────────────────────
POSTGRES_USER=mps
POSTGRES_PASSWORD=mps_secret
POSTGRES_DB=mps_rag
POSTGRES_URL=postgresql://mps:mps_secret@localhost:5432/mps_rag

# ── Mendeley Reference Manager ─────────────────────────────────────────
MENDELEY_CLIENT_ID=
MENDELEY_CLIENT_SECRET=

# ── Zotero Reference Manager ──────────────────────────────────────────
ZOTERO_API_KEY=
ZOTERO_USER_ID=

# ── Notion integration ─────────────────────────────────────────────────
NOTION_TOKEN=
NOTION_DATABASE_ID=

# Research Run write-back API (use private Bio-Research data-source IDs only)
# Accepts the UUID or full collection:// URI from the Notion data-source schema.
NOTION_ANALYSIS_RUNS_DATA_SOURCE_ID=
NOTION_PROJECTS_DATA_SOURCE_ID=
NOTION_PROTOCOLS_DATA_SOURCE_ID=
NOTION_SAMPLES_DATA_SOURCE_ID=
NOTION_EXPERIMENTAL_DATA_DATA_SOURCE_ID=
NOTION_LITERATURE_DATA_SOURCE_ID=
# Additional source IDs used by the full deployment relation-graph preflight.
NOTION_GENOMIC_SEQUENCE_DATA_SOURCE_ID=
NOTION_TASKS_DATA_SOURCE_ID=
NOTION_BRAIN_NOTES_DATA_SOURCE_ID=
# Must be an absolute path on persistent storage shared by all API workers.
# Render example; use an absolute local path for development.
RESEARCH_RUN_IDEMPOTENCY_DB=/var/data/research_run_idempotency.sqlite3
# Set true only for synthetic staging on ephemeral disks; never use for real research.
RESEARCH_RUN_ALLOW_EPHEMERAL_LEDGER=false
# Streamlit client uses this URL; API keys must be configured in deployment secrets.
RESEARCH_RUN_API_URL=http://localhost:8000

# ── Durable Supabase Auth (staged; disabled by default) ────────────────
# Use your Supabase project URL and public/publishable client key only.
# Never put the service-role key in Streamlit client authentication settings.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Older Supabase projects may use the anon key name instead.
SUPABASE_ANON_KEY=
# Server-side only: required for the durable job repository; never expose to clients.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AUTH_ENABLED=false
# Per-user job API is opt-in and must remain false until isolated staging tests pass.
USER_JOB_API_ENABLED=false
# Atomic rolling-window quota: max accepted jobs per user per hour (default 20).
USER_JOB_QUOTA_PER_HOUR=20
# Optional server-side allowlist of verified Supabase Auth user UUIDs; empty means no admins.
# Never use email addresses here. Keep this value only in server-side deployment env.
SUPABASE_ADMIN_USER_IDS=

# ── Security / Admin seeding ───────────────────────────────────────────
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
ADMIN_EMAILS=
JWT_SECRET_KEY=

# ── Services ───────────────────────────────────────────────────────────
FASTAPI_URL=http://localhost:8000
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_SERVER_ENABLE_CORS=false


# Sovereign Intelligence provider credentials
# Keep real credentials in .env or deployment environment variables.
# NEVER commit actual API keys.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# Primary/fallback provider routing
SOVEREIGN_AI_PROVIDER=openai
SOVEREIGN_AI_MODEL=gpt-5
SOVEREIGN_AI_FALLBACK_PROVIDER=anthropic
SOVEREIGN_AI_FALLBACK_MODEL=claude-sonnet-4-5

# Provider-specific model overrides
SOVEREIGN_AI_OPENAI_MODEL=gpt-5
SOVEREIGN_AI_ANTHROPIC_MODEL=claude-sonnet-4-5
SOVEREIGN_AI_GOOGLE_MODEL=gemini-2.5-flash
SOVEREIGN_AI_OPENROUTER_MODEL=openai/gpt-5
