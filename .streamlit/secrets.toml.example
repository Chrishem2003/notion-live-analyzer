# TEMPLATE ONLY. Copy values into Streamlit's secret manager.
# Never commit a real secrets.toml, client secret, or cookie secret.
[auth]
redirect_uri = "https://YOUR-APP-HOST/oauth2callback"
cookie_secret = "REPLACE_WITH_A_LONG_RANDOM_SECRET"
client_id = "REPLACE_WITH_OIDC_CLIENT_ID"
client_secret = "REPLACE_WITH_OIDC_CLIENT_SECRET"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

[nema_agora]
mode = "demo"
# Only set these after an approved persistent deployment location exists.
# database_path = "/approved/persistent/location/nema_agora.sqlite3"
# backup_dir = "/approved/backup/location"
# backup_retention = 7

[nema_agora.role_bindings]
# Key format: "<OIDC issuer>|<OIDC subject (sub)>"
# Replace this placeholder with the exact issuer and stable subject claim
# for each user, and assign the least-privileged role they require.
"https://accounts.google.com|REPLACE_WITH_ADMIN_SUBJECT" = "admin"
